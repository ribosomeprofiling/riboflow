// Build-from-FASTA mode: point the genome route at a stub FASTA+GTF instead of a
// pre-built STAR index, so STAR_INDEX runs.
//
// Config-file assignment, not `--input.reference.genome_fasta ...`: on Nextflow 26.04.x a
// dotted CLI param REPLACES its parent map, so those flags wipe the rest of
// `input.reference` — `filter` goes null and riboflow.nf:95 dies with
// "Cannot invoke split() on null object". See rnaseq_pe_none.config.
params.input.reference.genome_fasta = "${projectDir}/tests/stub/genome/dummy.fa"
params.input.reference.gtf          = "${projectDir}/tests/stub/genome/dummy.gtf"
