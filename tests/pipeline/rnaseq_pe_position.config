// Layers on top of rnaseq_pe.config to select dedup_method: position (rejected for PE).
//
// Config-file assignment, not the CLI form `--rnaseq.dedup_method position`: on Nextflow
// 26.04.x a dotted CLI param REPLACES its parent map instead of merging, so that flag wipes
// `rnaseq.fastq` — `do_rnaseq` (riboflow.nf:170) goes false, the PE guard never runs, and
// the run succeeds where this test expects a rejection. See rnaseq_pe_none.config.
params.rnaseq.dedup_method = 'position'
params.transcriptome.run   = false
