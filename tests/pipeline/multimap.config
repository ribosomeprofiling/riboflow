// Multi-mapper stats mode on the ribo-seq genome route (unique_only: false).
// Config-file assignment, not `--genome.mapping_quality_cutoff 0` (see tx_bam_dedup.config).
params.genome.unique_only            = false
params.genome.mapping_quality_cutoff = 0
params.dedup_method                  = 'position'

// Private output trees: the shared tests/stub/work_* storeDirs would serve files
// stored by an earlier case in the same run (e.g. a STAR_ALIGN output without the
// optional transcriptome BAM, or unique-mode count files), masking this case.
params.output = [
    individual_lane_directory: 'individual',
    merged_lane_directory:     'merged',
    intermediates: [ base: "${projectDir}/tests/stub/multimap_intermediates" ],
    output:        [ base: "${projectDir}/tests/stub/multimap_output" ]
]
