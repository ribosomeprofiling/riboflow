// Layers on top of rnaseq_pe.config: STAR transcriptome projection for both the
// ribo-seq and the PE RNA-seq genome paths (dedup none on the RNA-seq side).
// Config-file assignments, not dotted CLI params (see rnaseq_pe_none.config).
params.star.output_transcriptome_bam = true
params.rnaseq.dedup_method           = 'none'

// Private output trees: the shared tests/stub/work_* storeDirs hold STAR outputs
// without the optional transcriptome BAM, which would mask this case.
params.output = [
    individual_lane_directory: 'individual',
    merged_lane_directory:     'merged',
    intermediates: [ base: "${projectDir}/tests/stub/rnatx_intermediates" ],
    output:        [ base: "${projectDir}/tests/stub/rnatx_output" ]
]
