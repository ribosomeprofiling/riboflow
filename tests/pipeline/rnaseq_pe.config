// Paired-end RNA-seq fixture for the nf-test PE cases. Each lane is a 2-element
// [R1, R2] list; the stub FASTQs are reused as R1/R2 (stub mode never reads their
// contents). Sample names are P1/P2 — deliberately distinct from the SE S1/S2
// fixtures so the PE UMITOOLS_EXTRACT storeDir outputs (R1 shares its filename with
// the SE mode) can never be reused across an SE↔PE run. dedup_method defaults to
// umicollapse here; the position/none/transcriptome cases override on the CLI.
params {
    do_rnaseq = true
    rnaseq = [
        fastq_base:                  '',
        clip_arguments:              '-u 1 --quality-cutoff=28 --minimum-length=20',
        filter_arguments:            '-L 15 --no-unal',
        dedup_method:                'umicollapse',
        umi_tools_extract_arguments: '',
        genome:        [ mapping_quality_cutoff: 4,  samtools_filter_arguments: '-F 2308' ],
        transcriptome: [ mapping_quality_cutoff: 10, samtools_filter_arguments: '-F 2308',
                         alignment_arguments: '-L 15 --no-unal' ],
        fastq: [
            P1: [ ["${projectDir}/tests/stub/fastq/S1.l1.fastq.gz", "${projectDir}/tests/stub/fastq/S1.l2.fastq.gz"],
                  ["${projectDir}/tests/stub/fastq/S1.l1.fastq.gz", "${projectDir}/tests/stub/fastq/S1.l2.fastq.gz"] ],
            P2: [ ["${projectDir}/tests/stub/fastq/S2.l1.fastq.gz", "${projectDir}/tests/stub/fastq/S1.l2.fastq.gz"] ]
        ]
    ]
}
