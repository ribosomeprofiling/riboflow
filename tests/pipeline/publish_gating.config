// Dedicated output/intermediates bases for the publish-gating test, which asserts
// the ABSENCE of a file. The shared tests/stub/work_{output,intermediates} dirs
// accumulate across runs, so a dedup-none case writing *.qpass.merged.bam there
// would leave a stale file and fake a pass; this keeps that test's tree private.
params {
    output = [
        individual_lane_directory: 'individual',
        merged_lane_directory:     'merged',
        intermediates: [ base: "${projectDir}/tests/stub/gating_intermediates" ],
        output:        [ base: "${projectDir}/tests/stub/gating_output" ]
    ]
}
