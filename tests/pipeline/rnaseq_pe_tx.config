// Layers on top of rnaseq_pe.config to enable the transcriptome path (rejected for PE).
//
// Config-file assignment, not `--transcriptome.run true`: on Nextflow 26.04.x a dotted CLI
// param REPLACES its parent map, leaving `params.transcriptome` without the keys `do_tx`
// (riboflow.nf:39) and the downstream selectors expect. See rnaseq_pe_none.config.
params.transcriptome.run = true
