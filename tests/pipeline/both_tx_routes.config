// Both transcriptome routes at once: bowtie2 (transcriptome.run) AND the STAR
// projection dedup (star.output_transcriptome_bam + dedup). They must write to
// DIFFERENT trees — they used to share storeDir paths and overwrite each other.
params.transcriptome.run             = true
params.star.output_transcriptome_bam = true
params.dedup_method                  = 'position'

// Private output trees: the shared tests/stub/work_* storeDirs would serve files
// stored by an earlier case in the same run (e.g. a STAR_ALIGN output without the
// optional transcriptome BAM, or unique-mode count files), masking this case.
params.output = [
    individual_lane_directory: 'individual',
    merged_lane_directory:     'merged',
    intermediates: [ base: "${projectDir}/tests/stub/bothtx_intermediates" ],
    output:        [ base: "${projectDir}/tests/stub/bothtx_output" ]
]
