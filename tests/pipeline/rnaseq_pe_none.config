// Layers on top of rnaseq_pe.config to select dedup_method: none.
//
// Deliberately NOT the CLI form `--rnaseq.dedup_method none`: on Nextflow 26.04.x a
// dotted CLI param REPLACES its parent map instead of merging into it, so that flag
// wipes `rnaseq.fastq` — `do_rnaseq` (riboflow.nf:170) then evaluates false and the
// whole RNA-seq path is silently skipped. A config-file assignment merges correctly
// on both 25.10.x and 26.04.x.
params.rnaseq.dedup_method = 'none'
