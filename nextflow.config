nextflow.enable.dsl = 2

manifest {
    name            = 'riboflow_genome'
    homePage        = 'https://github.com/DanielNguyener/riboflow_genome'
    description     = 'Ribosome-profiling genome alignment pipeline (DSL2, nf-core layout).'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.0.0'
    version         = '2.0.0'
}

params {
    // Inputs / outputs come from the params YAML (see example_*.yaml). Everything
    // below is a default that a YAML may override.
    input  = null
    output = null

    // Ribo-seq pre-processing. clip_arguments has no sensible universal default (the
    // adapter is library-specific), so it must be set in the YAML; the workflow
    // refuses to run cutadapt with an empty string.
    clip_arguments              = null
    dedup_method                = 'none'
    deduplicate                 = false      // legacy boolean; dedup_method wins
    umi_tools_extract_arguments = ''
    umicollapse_arguments       = ''

    do_fastqc               = false
    do_strand_split         = false
    do_check_file_existence = false

    // Post-alignment quality filter. `unique_only` (genome routes) and
    // `samtools_count_arguments` are resolved in lib/Utils.groovy with documented
    // defaults when absent, so a YAML that only sets some keys keeps working.
    genome = [
        run:                    true,
        mapping_quality_cutoff: 255,
        samtools_filter_arguments: '-F 2308'
    ]

    transcriptome = [
        run:                    false,
        mapping_quality_cutoff: 10,
        samtools_filter_arguments: '-F 2308'
    ]

    alignment_arguments = [
        filter:        '-L 15 --no-unal --norc',
        transcriptome: '-L 15 --no-unal --norc'
    ]

    ribo = [
        ref_name:        'appris_human',
        metagene_radius: 50,
        left_span:       35,
        right_span:      15,
        read_length:     [ min: 15, max: 35 ],
        coverage:        true
    ]

    star = [
        output_transcriptome_bam: false,
        ribo_arguments:   '--alignEndsType EndToEnd',
        rnaseq_arguments: '--outFilterType BySJout --outFilterMultimapNmax 20 --alignSJoverhangMin 8 --alignSJDBoverhangMin 1 --outFilterMismatchNmax 999 --outFilterMismatchNoverReadLmax 0.04 --alignIntronMin 20 --alignIntronMax 1000000 --alignMatesGapMax 1000000',
        sjdb_overhang:    100,
        index_args:       ''
    ]

    do_rnaseq = false

    do_bigwig = false

    rnaseq = [
        fastq_base:                  '',
        clip_arguments:              '-u 1 --quality-cutoff=28 --minimum-length=20',
        filter_arguments:            '-L 15 --no-unal',
        dedup_method:                'none',
        umi_tools_extract_arguments: '',
        genome:       [ mapping_quality_cutoff: 4,  samtools_filter_arguments: '-F 2308' ],
        transcriptome:[ mapping_quality_cutoff: 10, samtools_filter_arguments: '-F 2308',
                        alignment_arguments: '-L 15 --no-unal' ]
    ]
}

includeConfig 'conf/modules.config'

process {
    cpus          = 1
    memory        = '2.GB'
    maxRetries    = 2
    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'terminate' }
    shell         = ['/bin/bash', '-uexo', 'pipefail']
}

profiles {

    'default' {
        includeConfig 'conf/default.config'
    }

    lonestar6 {
        includeConfig 'conf/lonestar6.config'
    }

    standard {
        includeConfig 'conf/default.config'
    }

    conda {
        conda.enabled  = true
        conda.channels = ['conda-forge', 'bioconda']
        process.conda  = "${projectDir}/environment.yaml"
        conda.cacheDir = "${projectDir}/conda_cache"
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = "${projectDir}/apptainer_cache"
        process.container    = 'docker://danielnguyener/riboflow:2.0.0'
    }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = 'danielnguyener/riboflow:2.0.0'
    }

    test {
        includeConfig 'conf/test.config'
    }
}

timeline { enabled = true; file = "./nextflow_logs/timeline.html"; overwrite = true }
trace    { enabled = true; file = "./nextflow_logs/trace.txt";    overwrite = true }
report   { enabled = true; file = "./nextflow_logs/report.html";  overwrite = true }
