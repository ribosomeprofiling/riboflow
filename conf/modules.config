// Per-process ext.* values, storeDir and publishDir rules.
//
// Config closures cannot see lib/Utils.groovy, and the strict config syntax
// (Nextflow ≥ 25) allows no `def` helpers in a config file. The few param-derived
// path pieces every rule needs are therefore declared ONCE as global process
// ext.* closures below and read back as `task.ext.<key>` inside the directive
// closures (ext closures resolve lazily, per task). Everything the MODULES need
// from params (MAPQ, filter/count arguments, unique-only mode) is resolved inside
// the module from `ext.route` via Utils — nothing here restates a default.
//
// Layout conventions:
//   new File(task.ext.inter_base, 'genome/alignment/' + task.ext.ind)   → <intermediates.base>/genome/alignment/individual
//   new File(task.ext.out_base,   task.ext.osub_alignments + '/ribo/' + task.ext.mrg) → <output.base>/alignments/ribo/merged
//   RNA-seq trees sit under <base>/rnaseq/.
//
// publishDir: BAM/BED/.ribo artifacts already live in a storeDir, so they are
// published as hard links (`mode: 'link'`, free on the same filesystem; Nextflow
// falls back to a copy across devices). Small CSV/HTML/ZIP reports are copied.
//
// NOTE: a run-time condition on publishing must live in `saveAs`, NOT in
// `enabled`. Nextflow resolves closures for `path`/`saveAs` but not for
// `enabled` — an `enabled:` closure stays unresolved, fails the truthiness
// check, and silently disables the publish rule for every run.

process {

    // ── shared path pieces (see header) ────────────────────────────────────
    ext.inter_base      = { (params.output?.intermediates?.base ?: 'intermediates').toString() }
    ext.out_base        = { (params.output?.output?.base        ?: 'output').toString() }
    ext.ind             = { (params.output?.individual_lane_directory ?: 'individual').toString() }
    ext.mrg             = { (params.output?.merged_lane_directory     ?: 'merged').toString() }
    ext.isub_clip       = { ((params.output?.intermediates ?: [:]) as Map).getOrDefault('clip',       'clip').toString() }
    ext.isub_umi_tools  = { ((params.output?.intermediates ?: [:]) as Map).getOrDefault('umi_tools',  'umi_tools').toString() }
    ext.isub_filter     = { ((params.output?.intermediates ?: [:]) as Map).getOrDefault('filter',     'filter').toString() }
    ext.isub_stats      = { ((params.output?.intermediates ?: [:]) as Map).getOrDefault('stats',      'stats').toString() }
    ext.osub_fastqc     = { ((params.output?.output ?: [:]) as Map).getOrDefault('fastqc',     'fastqc').toString() }
    ext.osub_alignments = { ((params.output?.output ?: [:]) as Map).getOrDefault('alignments', 'alignments').toString() }
    ext.osub_bigwigs    = { ((params.output?.output ?: [:]) as Map).getOrDefault('bigwigs',    'bigwigs').toString() }
    ext.osub_ribo       = { ((params.output?.output ?: [:]) as Map).getOrDefault('ribo',       'ribo').toString() }
    ext.osub_stats      = { ((params.output?.output ?: [:]) as Map).getOrDefault('stats',      'stats').toString() }
    // Ribo-seq dedup "none" (honours the legacy `deduplicate` flag like Utils does) / RNA-seq.
    ext.ribo_dedup_none = { (params.dedup_method ?: 'none').toString().toLowerCase() == 'none' &&
                            !((params.deduplicate ?: false).toString().toLowerCase() in ['true', 'yes', 'on', '1']) }
    ext.rna_dedup_none  = { (params.rnaseq?.dedup_method ?: 'none').toString().toLowerCase() == 'none' }

    // ── Ribo-seq preprocess ────────────────────────────────────────────────
    withName: CUTADAPT_CLIP {
        storeDir = { new File(task.ext.inter_base, task.ext.isub_clip).canonicalPath }
    }
    withName: UMITOOLS_EXTRACT {
        storeDir = { new File(task.ext.inter_base, task.ext.isub_umi_tools + '/' + task.ext.mrg).canonicalPath }
    }
    withName: BOWTIE2_FILTER {
        storeDir = { new File(task.ext.inter_base, task.ext.isub_filter).canonicalPath }
    }
    withName: RAW_FASTQC {
        ext.prefix = { "${meta.id}.${meta.lane}" }
        publishDir = [ path: { new File(task.ext.out_base, task.ext.osub_fastqc + '/raw').canonicalPath }, mode: 'copy' ]
    }
    withName: CLIPPED_FASTQC {
        ext.prefix = { "${meta.id}.${meta.lane}.clipped" }
        publishDir = [ path: { new File(task.ext.out_base, task.ext.osub_fastqc + '/clipped').canonicalPath }, mode: 'copy' ]
    }
    withName: GENOME_ALIGNED_FASTQC {
        ext.prefix = { "${meta.id}.${meta.lane}.genome.aligned" }
        publishDir = [ path: { new File(task.ext.out_base, task.ext.osub_fastqc + '/genome_aligned').canonicalPath }, mode: 'copy' ]
    }
    withName: GENOME_UNALIGNED_FASTQC {
        ext.prefix = { "${meta.id}.${meta.lane}.genome.unaligned" }
        publishDir = [ path: { new File(task.ext.out_base, task.ext.osub_fastqc + '/genome_unaligned').canonicalPath }, mode: 'copy' ]
    }
    withName: TX_ALIGNED_FASTQC {
        ext.prefix = { "${meta.id}.${meta.lane}.transcriptome.aligned" }
        publishDir = [ path: { new File(task.ext.out_base, task.ext.osub_fastqc + '/transcriptome_aligned').canonicalPath }, mode: 'copy' ]
    }
    withName: TX_UNALIGNED_FASTQC {
        ext.prefix = { "${meta.id}.${meta.lane}.transcriptome.unaligned" }
        publishDir = [ path: { new File(task.ext.out_base, task.ext.osub_fastqc + '/transcriptome_unaligned').canonicalPath }, mode: 'copy' ]
    }

    withName: STAR_INDEX {
        storeDir = {
            def d = params.star?.getOrDefault('index_dir', null)
            d ? new File(d).canonicalPath : new File(task.ext.inter_base, 'star_index').canonicalPath
        }
        ext.sjdb_overhang = { params.star?.getOrDefault('sjdb_overhang', 100) }
    }

    // ── Ribo-seq genome route ──────────────────────────────────────────────
    withName: STAR_ALIGN {
        storeDir = { new File(task.ext.inter_base, 'genome/alignment/' + task.ext.ind).canonicalPath }
    }
    withName: '.*:GENOME_ALIGN:SAMTOOLS_QPASS' {
        ext.route  = 'genome'
        ext.prefix = { "${meta.id}.${meta.lane}.genome_alignment" }
        storeDir   = { new File(task.ext.inter_base, 'genome/quality_filter').canonicalPath }
    }
    withName: '.*:GENOME_ALIGN:BAM_TO_BED' {
        ext.route          = 'genome'
        ext.prefix         = { "${meta.id}.${meta.lane}.genome.qpass" }
        ext.indexed_prefix = { "${meta.id}.${meta.lane}.genome.with_sample_index" }
        storeDir   = { new File(task.ext.inter_base, 'genome/bam_to_bed/' + task.ext.ind).canonicalPath }
        publishDir = [ path: { new File(task.ext.out_base, task.ext.osub_alignments + '/ribo/' + task.ext.ind).canonicalPath }, mode: 'link',
                       saveAs: { fn -> (task.ext.ribo_dedup_none && !fn.contains('.with_sample_index.')) ? fn : null } ]
    }
    withName: '.*:GENOME_ALIGN:SAMTOOLS_MERGE' {
        ext.prefix = { "${meta.id}.genome.qpass.merged" }
        storeDir   = { new File(task.ext.inter_base, 'genome/alignment/' + task.ext.mrg).canonicalPath }
        publishDir = [ path: { new File(task.ext.out_base, task.ext.osub_alignments + '/ribo/' + task.ext.mrg).canonicalPath }, mode: 'link',
                       saveAs: { fn -> task.ext.ribo_dedup_none ? fn : null } ]
    }
    withName: MERGE_PRE_DEDUP_BED {
        ext.prefix = { "${meta.id}.genome.merged.pre_dedup" }
        storeDir   = { new File(task.ext.inter_base, 'genome/bam_to_bed/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:GENOME_ALIGN:RFC_DEDUP' {
        ext.prefix = { "${meta.id}.genome" }
        storeDir   = { new File(task.ext.out_base, task.ext.osub_alignments + '/ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:GENOME_ALIGN:SEPARATE_BED' {
        ext.route       = 'genome'
        ext.suffix      = 'genome'
        ext.emit_counts = true
        storeDir   = { new File(task.ext.inter_base, 'genome/alignment_ribo/' + task.ext.ind).canonicalPath }
        publishDir = [ path: { new File(task.ext.out_base, task.ext.osub_alignments + '/ribo/' + task.ext.ind).canonicalPath }, mode: 'link', saveAs: { fn -> fn.endsWith('.count') ? null : fn } ]
    }
    withName: '.*:GENOME_ALIGN:RFC_EXTRACT_DEDUP_READS' {
        ext.route       = 'genome'
        ext.prefix      = { "${meta.id}.post_dedup" }
        ext.emit_counts = true
        storeDir   = { new File(task.ext.inter_base, 'genome/alignment_ribo/' + task.ext.mrg).canonicalPath }
        publishDir = [ path: { new File(task.ext.out_base, task.ext.osub_alignments + '/ribo/' + task.ext.mrg).canonicalPath }, mode: 'link', saveAs: { fn -> fn.endsWith('.count') ? null : fn } ]
    }
    withName: '.*:GENOME_ALIGN:UMICOLLAPSE_DEDUP' {
        ext.route       = 'genome'
        ext.prefix      = { "${meta.id}.dedup" }
        ext.emit_counts = true
        storeDir   = { new File(task.ext.inter_base, 'genome/alignment_ribo/' + task.ext.mrg).canonicalPath }
        publishDir = [ path: { new File(task.ext.out_base, task.ext.osub_alignments + '/ribo/' + task.ext.mrg).canonicalPath }, mode: 'link', saveAs: { fn -> fn.endsWith('.count') ? null : fn } ]
    }
    withName: '.*:GENOME_ALIGN:SPLIT_DEDUP_BAM' {
        ext.route           = 'genome'
        ext.suffix          = 'post_dedup'
        ext.bed_suffix      = 'genome.post_dedup'
        ext.emit_bed_counts = true
        storeDir   = { new File(task.ext.inter_base, 'genome/alignment_ribo/' + task.ext.ind).canonicalPath }
        publishDir = [ path: { new File(task.ext.out_base, task.ext.osub_alignments + '/ribo/' + task.ext.ind).canonicalPath }, mode: 'link', saveAs: { fn -> fn.endsWith('.count') ? null : fn } ]
    }
    withName: CONCAT_POST_DEDUP_BED {
        ext.prefix = { "${meta.id}.genome.post_dedup" }
        storeDir   = { new File(task.ext.out_base, task.ext.osub_alignments + '/ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: CONCAT_QPASS_BED_NONE {
        ext.prefix = { "${meta.id}.genome.qpass" }
        storeDir   = { new File(task.ext.inter_base, 'genome/bam_to_bed/' + task.ext.mrg).canonicalPath }
        publishDir = [ path: { new File(task.ext.out_base, task.ext.osub_alignments + '/ribo/' + task.ext.mrg).canonicalPath }, mode: 'link' ]
    }
    withName: DEEPTOOLS_BAMCOVERAGE {
        storeDir = { new File(task.ext.out_base, task.ext.osub_bigwigs + '/ribo').canonicalPath }
    }
    withName: SPLIT_STRANDED_BAM {
        storeDir = { new File(task.ext.out_base, task.ext.osub_alignments + '/ribo/stranded').canonicalPath }
    }

    // ── Ribo-seq genome stats ──────────────────────────────────────────────
    withName: '.*:ALIGNMENT_STATS:STATS_INDIVIDUAL' {
        ext.route       = 'genome'
        ext.stats_label = 'genome'
        storeDir = { new File(task.ext.inter_base, task.ext.isub_stats + '/genome/individual').canonicalPath }
    }
    withName: '.*:ALIGNMENT_STATS:COMBINE_INDIVIDUAL' {
        ext.route  = 'genome'
        ext.prefix = 'genome_individual_essential'
        storeDir   = { new File(task.ext.inter_base, task.ext.isub_stats + '/genome/individual').canonicalPath }
    }
    withName: '.*:ALIGNMENT_STATS:STATS_SUM' {
        ext.route             = 'genome'
        ext.label             = 'genome'
        ext.use_merged_counts = { !task.ext.ribo_dedup_none }
        storeDir = { new File(task.ext.inter_base, task.ext.isub_stats + '/genome/merged').canonicalPath }
    }
    withName: '.*:ALIGNMENT_STATS:COMBINE_MERGED' {
        ext.route  = 'genome'
        ext.prefix = 'genome_merged_essential'
        storeDir   = { new File(task.ext.inter_base, task.ext.isub_stats + '/genome/merged').canonicalPath }
    }
    withName: '.*:ALIGNMENT_STATS:STATS_PUBLISH' {
        publishDir = [ path: { new File(task.ext.out_base, task.ext.osub_stats + '/genome').canonicalPath }, mode: 'copy' ]
    }
    withName: WRITE_CORRESPONDENCE {
        publishDir = [ path: { new File(task.ext.out_base, task.ext.osub_stats).canonicalPath }, mode: 'copy' ]
    }

    // ── Ribo-seq transcriptome stats (bowtie2 route) ───────────────────────
    withName: '.*:TRANSCRIPTOME_STATS:TX_STATS_INDIVIDUAL' {
        ext.stats_label = 'transcriptome'
        storeDir = { new File(task.ext.inter_base, task.ext.isub_stats + '/transcriptome/individual').canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_STATS:TX_COMBINE_INDIVIDUAL' {
        ext.prefix      = 'transcriptome_individual_essential'
        ext.stats_label = 'transcriptome'
        storeDir        = { new File(task.ext.inter_base, task.ext.isub_stats + '/transcriptome/individual').canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_STATS:TX_STATS_SUM' {
        ext.label             = 'transcriptome'
        ext.use_merged_counts = false
        storeDir = { new File(task.ext.inter_base, task.ext.isub_stats + '/transcriptome/merged').canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_STATS:TX_COMBINE_MERGED' {
        ext.prefix      = 'transcriptome_merged_essential'
        ext.stats_label = 'transcriptome'
        storeDir        = { new File(task.ext.inter_base, task.ext.isub_stats + '/transcriptome/merged').canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_STATS:TX_STATS_PUBLISH' {
        publishDir = [ path: { new File(task.ext.out_base, task.ext.osub_stats + '/transcriptome').canonicalPath }, mode: 'copy' ]
    }

    // ── STAR transcriptome projection dedup (star.output_transcriptome_bam) ─
    // Its own `star_transcriptome` tree and `.star_transcriptome.` filenames: it
    // used to share the bowtie2 transcriptome route's paths, so when both ran the
    // storeDir of whichever finished first was silently served to the other.
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SAMTOOLS_QPASS' {
        ext.route                  = 'star_transcriptome'
        ext.prefix                 = { "${meta.id}.${meta.lane}.star_transcriptome_alignment" }
        ext.presort                = true
        ext.emit_primary_secondary = false
        ext.count_unique           = false
        storeDir = { new File(task.ext.inter_base, 'star_transcriptome/quality_filter/' + task.ext.ind).canonicalPath }
    }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:BAM_TO_BED' {
        ext.prefix       = { "${meta.id}.${meta.lane}.star_transcriptome.with_sample_index" }
        ext.append_index = true
        storeDir         = { new File(task.ext.inter_base, 'star_transcriptome/quality_filter/' + task.ext.ind).canonicalPath }
    }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:CONCAT_SORT_BED' {
        ext.prefix = { "${meta.id}.star_transcriptome.merged.pre_dedup" }
        storeDir   = { new File(task.ext.inter_base, 'star_transcriptome/alignment_ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:RFC_DEDUP' {
        ext.prefix = { "${meta.id}.star_transcriptome" }
        storeDir   = { new File(task.ext.inter_base, 'star_transcriptome/alignment_ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SEPARATE_BED' {
        ext.route  = 'star_transcriptome'
        ext.suffix = 'star_transcriptome'
        storeDir   = { new File(task.ext.inter_base, 'star_transcriptome/alignment_ribo/' + task.ext.ind).canonicalPath }
    }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SAMTOOLS_MERGE' {
        ext.prefix = { "${meta.id}.star_transcriptome.qpass.merged" }
        storeDir   = { new File(task.ext.inter_base, 'star_transcriptome/alignment/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:RFC_EXTRACT_DEDUP_READS' {
        ext.route  = 'star_transcriptome'
        ext.prefix = { "${meta.id}.star_transcriptome.post_dedup" }
        storeDir   = { new File(task.ext.inter_base, 'star_transcriptome/alignment_ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:UMICOLLAPSE_DEDUP' {
        ext.route  = 'star_transcriptome'
        ext.prefix = { "${meta.id}.star_transcriptome.dedup" }
        storeDir   = { new File(task.ext.inter_base, 'star_transcriptome/alignment_ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SPLIT_DEDUP_BAM' {
        ext.route      = 'star_transcriptome'
        ext.suffix     = 'star_transcriptome.post_dedup'
        ext.bed_suffix = 'star_transcriptome.post_dedup'
        storeDir       = { new File(task.ext.inter_base, 'star_transcriptome/alignment_ribo/' + task.ext.ind).canonicalPath }
    }

    // ── Ribo-seq transcriptome route (bowtie2 → .ribo) ─────────────────────
    withName: '.*:TRANSCRIPTOME_ALIGN:BOWTIE2_TRANSCRIPTOME' {
        storeDir = { new File(task.ext.inter_base, 'transcriptome/alignment/' + task.ext.ind).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:SAMTOOLS_QPASS' {
        ext.route                  = 'transcriptome'
        ext.prefix                 = { "${meta.id}.${meta.lane}.transcriptome_alignment" }
        ext.presort                = false
        ext.emit_primary_secondary = false
        ext.count_unique           = false
        storeDir                   = { new File(task.ext.inter_base, 'transcriptome/quality_filter').canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:SAMTOOLS_MERGE' {
        ext.prefix = { "${meta.id}.transcriptome.qpass.merged" }
        storeDir   = { new File(task.ext.inter_base, 'transcriptome/alignment/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:TX_QPASS_BAM_TO_BED' {
        ext.prefix       = { "${meta.id}.${meta.lane}.transcriptome.with_sample_index" }
        ext.append_index = true
        storeDir         = { new File(task.ext.inter_base, 'transcriptome/quality_filter').canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:TX_MERGED_QPASS_BED' {
        ext.prefix = { "${meta.id}.transcriptome.qpass.merged" }
        storeDir   = { new File(task.ext.inter_base, 'transcriptome/alignment_ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:TX_MERGED_DEDUP_BED' {
        ext.prefix = { "${meta.id}.transcriptome.dedup" }
        storeDir   = { new File(task.ext.inter_base, 'transcriptome/alignment_ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:MERGE_TX_PRE_DEDUP_BED' {
        ext.prefix = { "${meta.id}.transcriptome.merged.pre_dedup" }
        storeDir   = { new File(task.ext.inter_base, 'transcriptome/alignment_ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:RFC_DEDUP' {
        ext.prefix = { "${meta.id}.transcriptome" }
        storeDir   = { new File(task.ext.inter_base, 'transcriptome/alignment_ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:SEPARATE_BED' {
        ext.route            = 'transcriptome'
        ext.suffix           = 'transcriptome'
        ext.emit_counts      = true
        ext.emit_full_counts = false
        storeDir = { new File(task.ext.inter_base, 'transcriptome/alignment_ribo/' + task.ext.ind).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:RFC_EXTRACT_DEDUP_READS' {
        ext.route       = 'transcriptome'
        ext.prefix      = { "${meta.id}.transcriptome.post_dedup" }
        ext.emit_counts = false
        storeDir        = { new File(task.ext.inter_base, 'transcriptome/alignment_ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:UMICOLLAPSE_DEDUP' {
        ext.route       = 'transcriptome'
        ext.prefix      = { "${meta.id}.transcriptome.dedup" }
        ext.emit_counts = false
        storeDir        = { new File(task.ext.inter_base, 'transcriptome/alignment_ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:SPLIT_DEDUP_BAM' {
        ext.route            = 'transcriptome'
        ext.suffix           = 'transcriptome.post_dedup'
        ext.bed_suffix       = 'transcriptome.post_dedup'
        ext.emit_bed_counts  = true
        ext.emit_full_counts = false
        storeDir = { new File(task.ext.inter_base, 'transcriptome/alignment_ribo/' + task.ext.ind).canonicalPath }
    }
    withName: 'RIBOPY_CREATE' {
        storeDir = { new File(task.ext.out_base, task.ext.osub_ribo).canonicalPath }
    }

    // ── RNA-seq preprocess ─────────────────────────────────────────────────
    withName: RNASEQ_RAW_FASTQC {
        ext.prefix = { "${meta.id}.${meta.lane}" }
        publishDir = [ path: { new File(task.ext.out_base, 'rnaseq/' + task.ext.osub_fastqc + '/raw').canonicalPath }, mode: 'copy' ]
    }
    withName: RNASEQ_CLIPPED_FASTQC {
        ext.prefix = { "${meta.id}.${meta.lane}.clipped" }
        publishDir = [ path: { new File(task.ext.out_base, 'rnaseq/' + task.ext.osub_fastqc + '/clipped').canonicalPath }, mode: 'copy' ]
    }
    withName: CUTADAPT_CLIP_RNASEQ {
        storeDir = { new File(task.ext.inter_base, 'rnaseq/clip').canonicalPath }
    }
    withName: '.*:RNASEQ_PREPROCESS:UMITOOLS_EXTRACT' {
        ext.args = { params.rnaseq?.umi_tools_extract_arguments ?: '' }
        storeDir = { new File(task.ext.inter_base, 'rnaseq/umi_tools/' + task.ext.mrg).canonicalPath }
    }
    withName: BOWTIE2_FILTER_RNASEQ {
        storeDir = { new File(task.ext.inter_base, 'rnaseq/filter').canonicalPath }
    }

    // ── RNA-seq genome route ───────────────────────────────────────────────
    withName: STAR_ALIGN_RNASEQ {
        storeDir   = { new File(task.ext.inter_base, 'rnaseq/genome/alignment/' + task.ext.ind).canonicalPath }
        publishDir = [ path: { new File(task.ext.inter_base, 'rnaseq/stats/genome/individual').canonicalPath },
                       mode: 'copy', saveAs: { fn -> fn.endsWith('.log') ? fn : null } ]
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:SAMTOOLS_QPASS' {
        ext.route  = 'rnaseq_genome'
        ext.prefix = { "${meta.id}.${meta.lane}.rnaseq.genome_alignment" }
        storeDir   = { new File(task.ext.inter_base, 'rnaseq/genome/quality_filter').canonicalPath }
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:BAM_TO_BED' {
        ext.prefix         = { "${meta.id}.${meta.lane}.rnaseq.genome.qpass" }
        ext.indexed_prefix = { "${meta.id}.${meta.lane}.rnaseq.genome.with_sample_index" }
        storeDir   = { new File(task.ext.inter_base, 'rnaseq/genome/bam_to_bed/' + task.ext.ind).canonicalPath }
        publishDir = [ path: { new File(task.ext.out_base, 'rnaseq/' + task.ext.osub_alignments + '/genome/' + task.ext.ind).canonicalPath }, mode: 'link',
                       saveAs: { fn -> (task.ext.rna_dedup_none && !fn.contains('.with_sample_index.')) ? fn : null } ]
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:SAMTOOLS_MERGE' {
        ext.prefix = { "${meta.id}.rnaseq.genome.qpass.merged" }
        storeDir   = { new File(task.ext.inter_base, 'rnaseq/genome/alignment/' + task.ext.mrg).canonicalPath }
        publishDir = [ path: { new File(task.ext.out_base, 'rnaseq/' + task.ext.osub_alignments + '/genome/' + task.ext.mrg).canonicalPath }, mode: 'link',
                       saveAs: { fn -> task.ext.rna_dedup_none ? fn : null } ]
    }
    withName: 'RNASEQ_MERGE_PRE_DEDUP_BED' {
        ext.prefix = { "${meta.id}.rnaseq.genome.merged.pre_dedup" }
        storeDir   = { new File(task.ext.inter_base, 'rnaseq/genome/bam_to_bed/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:RFC_DEDUP' {
        ext.prefix = { "${meta.id}.rnaseq.genome" }
        storeDir   = { new File(task.ext.out_base, 'rnaseq/' + task.ext.osub_alignments + '/genome/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:SEPARATE_BED' {
        ext.route       = 'rnaseq_genome'
        ext.suffix      = 'rnaseq.genome'
        ext.emit_counts = true
        storeDir   = { new File(task.ext.inter_base, 'rnaseq/genome/alignment_ribo/' + task.ext.ind).canonicalPath }
        publishDir = [ path: { new File(task.ext.out_base, 'rnaseq/' + task.ext.osub_alignments + '/genome/' + task.ext.ind).canonicalPath }, mode: 'link', saveAs: { fn -> fn.endsWith('.count') ? null : fn } ]
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:RFC_EXTRACT_DEDUP_READS' {
        ext.route       = 'rnaseq_genome'
        ext.prefix      = { "${meta.id}.rnaseq.post_dedup" }
        ext.emit_counts = true
        storeDir   = { new File(task.ext.inter_base, 'rnaseq/genome/alignment_ribo/' + task.ext.mrg).canonicalPath }
        publishDir = [ path: { new File(task.ext.out_base, 'rnaseq/' + task.ext.osub_alignments + '/genome/' + task.ext.mrg).canonicalPath }, mode: 'link', saveAs: { fn -> fn.endsWith('.count') ? null : fn } ]
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:UMICOLLAPSE_DEDUP' {
        ext.route       = 'rnaseq_genome'
        ext.prefix      = { "${meta.id}.rnaseq.dedup" }
        ext.emit_counts = true
        storeDir   = { new File(task.ext.inter_base, 'rnaseq/genome/alignment_ribo/' + task.ext.mrg).canonicalPath }
        publishDir = [ path: { new File(task.ext.out_base, 'rnaseq/' + task.ext.osub_alignments + '/genome/' + task.ext.mrg).canonicalPath }, mode: 'link', saveAs: { fn -> fn.endsWith('.count') ? null : fn } ]
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:SPLIT_DEDUP_BAM' {
        ext.route           = 'rnaseq_genome'
        ext.suffix          = 'rnaseq.post_dedup'
        ext.bed_suffix      = 'rnaseq.genome.post_dedup'
        ext.emit_bed_counts = true
        storeDir   = { new File(task.ext.inter_base, 'rnaseq/genome/alignment_ribo/' + task.ext.ind).canonicalPath }
        publishDir = [ path: { new File(task.ext.out_base, 'rnaseq/' + task.ext.osub_alignments + '/genome/' + task.ext.ind).canonicalPath }, mode: 'link', saveAs: { fn -> fn.endsWith('.count') ? null : fn } ]
    }
    withName: 'RNASEQ_CONCAT_QPASS_BED_NONE' {
        ext.prefix = { "${meta.id}.rnaseq.genome.qpass" }
        storeDir   = { new File(task.ext.inter_base, 'rnaseq/genome/bam_to_bed/' + task.ext.mrg).canonicalPath }
        publishDir = [ path: { new File(task.ext.out_base, 'rnaseq/' + task.ext.osub_alignments + '/genome/' + task.ext.mrg).canonicalPath }, mode: 'link' ]
    }
    withName: 'RNASEQ_CONCAT_POST_DEDUP_BED' {
        ext.prefix = { "${meta.id}.rnaseq.genome.post_dedup" }
        storeDir   = { new File(task.ext.out_base, 'rnaseq/' + task.ext.osub_alignments + '/genome/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:DEEPTOOLS_BAMCOVERAGE' {
        storeDir = { new File(task.ext.out_base, 'rnaseq/' + task.ext.osub_bigwigs + '/genome').canonicalPath }
    }

    // ── RNA-seq transcriptome route ────────────────────────────────────────
    withName: BOWTIE2_TRANSCRIPTOME_RNASEQ {
        storeDir = { new File(task.ext.inter_base, 'rnaseq/transcriptome/alignment/' + task.ext.ind).canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:SAMTOOLS_QPASS' {
        ext.route                  = 'rnaseq_transcriptome'
        ext.prefix                 = { "${meta.id}.${meta.lane}.rnaseq.transcriptome_alignment" }
        ext.presort                = false
        ext.emit_primary_secondary = false
        ext.count_unique           = false
        storeDir                   = { new File(task.ext.inter_base, 'rnaseq/transcriptome/quality_filter').canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:SAMTOOLS_MERGE' {
        ext.prefix = { "${meta.id}.rnaseq.transcriptome.qpass.merged" }
        storeDir   = { new File(task.ext.inter_base, 'rnaseq/transcriptome/alignment/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:RNASEQ_TX_QPASS_BAM_TO_BED' {
        ext.prefix       = { "${meta.id}.${meta.lane}.rnaseq.transcriptome.with_sample_index" }
        ext.append_index = true
        storeDir         = { new File(task.ext.inter_base, 'rnaseq/transcriptome/quality_filter').canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:RNASEQ_TX_MERGED_QPASS_BED' {
        ext.prefix = { "${meta.id}.rnaseq.transcriptome.qpass.merged" }
        storeDir   = { new File(task.ext.inter_base, 'rnaseq/transcriptome/alignment_ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:RNASEQ_TX_MERGED_DEDUP_BED' {
        ext.prefix = { "${meta.id}.rnaseq.transcriptome.dedup" }
        storeDir   = { new File(task.ext.inter_base, 'rnaseq/transcriptome/alignment_ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: 'RNASEQ_MERGE_TX_PRE_DEDUP_BED' {
        ext.prefix = { "${meta.id}.rnaseq.transcriptome.merged.pre_dedup" }
        storeDir   = { new File(task.ext.inter_base, 'rnaseq/transcriptome/alignment_ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:RFC_DEDUP' {
        ext.prefix = { "${meta.id}.rnaseq.transcriptome" }
        storeDir   = { new File(task.ext.inter_base, 'rnaseq/transcriptome/alignment_ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:SEPARATE_BED' {
        ext.route            = 'rnaseq_transcriptome'
        ext.suffix           = 'rnaseq.transcriptome'
        ext.emit_counts      = true
        ext.emit_full_counts = false
        storeDir = { new File(task.ext.inter_base, 'rnaseq/transcriptome/alignment_ribo/' + task.ext.ind).canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:RFC_EXTRACT_DEDUP_READS' {
        ext.route       = 'rnaseq_transcriptome'
        ext.prefix      = { "${meta.id}.rnaseq.transcriptome.post_dedup" }
        ext.emit_counts = false
        storeDir        = { new File(task.ext.inter_base, 'rnaseq/transcriptome/alignment_ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:UMICOLLAPSE_DEDUP' {
        ext.route       = 'rnaseq_transcriptome'
        ext.prefix      = { "${meta.id}.rnaseq.transcriptome.dedup" }
        ext.emit_counts = false
        storeDir        = { new File(task.ext.inter_base, 'rnaseq/transcriptome/alignment_ribo/' + task.ext.mrg).canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:SPLIT_DEDUP_BAM' {
        ext.route            = 'rnaseq_transcriptome'
        ext.suffix           = 'rnaseq.transcriptome.post_dedup'
        ext.bed_suffix       = 'rnaseq.transcriptome.post_dedup'
        ext.emit_bed_counts  = true
        ext.emit_full_counts = false
        storeDir = { new File(task.ext.inter_base, 'rnaseq/transcriptome/alignment_ribo/' + task.ext.ind).canonicalPath }
    }

    withName: RIBOPY_RNASEQ_SET {
        storeDir   = { new File(task.ext.inter_base, 'transcriptome/ribo_rnaseq').canonicalPath }
        publishDir = [ path: { new File(task.ext.out_base, task.ext.osub_ribo).canonicalPath }, mode: 'link',
                       saveAs: { fn -> fn.replaceAll('\\.rnaseq', '') } ]
    }
    withName: RIBOPY_MERGE {
        storeDir = { new File(task.ext.out_base, task.ext.osub_ribo).canonicalPath }
    }

    // ── RNA-seq genome stats (ALIGNMENT_STATS aliased as RNASEQ_GENOME_STATS) ─
    withName: '.*:RNASEQ_GENOME_STATS:STATS_INDIVIDUAL' {
        ext.route       = 'rnaseq_genome'
        ext.stats_label = 'rnaseq_genome'
        storeDir = { new File(task.ext.inter_base, 'rnaseq/stats/genome/individual').canonicalPath }
    }
    withName: '.*:RNASEQ_GENOME_STATS:COMBINE_INDIVIDUAL' {
        ext.route  = 'rnaseq_genome'
        ext.prefix = 'rnaseq_genome_individual_essential'
        storeDir   = { new File(task.ext.inter_base, 'rnaseq/stats/genome/individual').canonicalPath }
    }
    withName: '.*:RNASEQ_GENOME_STATS:STATS_SUM' {
        ext.route             = 'rnaseq_genome'
        ext.label             = 'rnaseq_genome'
        ext.use_merged_counts = { !task.ext.rna_dedup_none }
        storeDir = { new File(task.ext.inter_base, 'rnaseq/stats/genome/merged').canonicalPath }
    }
    withName: '.*:RNASEQ_GENOME_STATS:COMBINE_MERGED' {
        ext.route  = 'rnaseq_genome'
        ext.prefix = 'rnaseq_genome_merged_essential'
        storeDir   = { new File(task.ext.inter_base, 'rnaseq/stats/genome/merged').canonicalPath }
    }
    withName: '.*:RNASEQ_GENOME_STATS:STATS_PUBLISH' {
        publishDir = [ path: { new File(task.ext.out_base, 'rnaseq/' + task.ext.osub_stats + '/genome').canonicalPath }, mode: 'copy' ]
    }

    // ── RNA-seq transcriptome stats (TRANSCRIPTOME_STATS aliased as RNASEQ_TX_STATS)
    withName: '.*:RNASEQ_TX_STATS:TX_STATS_INDIVIDUAL' {
        ext.stats_label = 'rnaseq_transcriptome'
        storeDir = { new File(task.ext.inter_base, 'rnaseq/stats/transcriptome/individual').canonicalPath }
    }
    withName: '.*:RNASEQ_TX_STATS:TX_COMBINE_INDIVIDUAL' {
        ext.prefix      = 'rnaseq_transcriptome_individual_essential'
        ext.stats_label = 'transcriptome'
        storeDir        = { new File(task.ext.inter_base, 'rnaseq/stats/transcriptome/individual').canonicalPath }
    }
    withName: '.*:RNASEQ_TX_STATS:TX_STATS_SUM' {
        ext.label             = 'rnaseq_transcriptome'
        ext.use_merged_counts = false
        storeDir = { new File(task.ext.inter_base, 'rnaseq/stats/transcriptome/merged').canonicalPath }
    }
    withName: '.*:RNASEQ_TX_STATS:TX_COMBINE_MERGED' {
        ext.prefix      = 'rnaseq_transcriptome_merged_essential'
        ext.stats_label = 'transcriptome'
        storeDir        = { new File(task.ext.inter_base, 'rnaseq/stats/transcriptome/merged').canonicalPath }
    }
    withName: '.*:RNASEQ_TX_STATS:TX_STATS_PUBLISH' {
        publishDir = [ path: { new File(task.ext.out_base, 'rnaseq/' + task.ext.osub_stats + '/transcriptome').canonicalPath }, mode: 'copy' ]
    }
}
