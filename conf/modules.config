process {

    // ── Ribo-seq preprocess ────────────────────────────────────────────────
    withName: CUTADAPT_CLIP {
        storeDir = { new File((params.output?.intermediates?.base ?: 'intermediates').toString(), 'clip').canonicalPath }
    }
    withName: UMITOOLS_EXTRACT {
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), ((params.output?.intermediates?.umi_tools ?: 'umi_tools') as String) + '/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: BOWTIE2_FILTER {
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), ((params.output?.intermediates?.filter ?: 'filter') as String)).canonicalPath }
    }
    withName: RAW_FASTQC {
        ext.prefix = { "${meta.id}.${meta.lane}" }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.fastqc ?: 'fastqc') as String) + '/raw').canonicalPath }, mode: 'copy' ]
    }
    withName: CLIPPED_FASTQC {
        ext.prefix = { "${meta.id}.${meta.lane}.clipped" }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.fastqc ?: 'fastqc') as String) + '/clipped').canonicalPath }, mode: 'copy' ]
    }
    withName: GENOME_ALIGNED_FASTQC {
        ext.prefix = { "${meta.id}.${meta.lane}.genome.aligned" }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.fastqc ?: 'fastqc') as String) + '/genome_aligned').canonicalPath }, mode: 'copy' ]
    }
    withName: GENOME_UNALIGNED_FASTQC {
        ext.prefix = { "${meta.id}.${meta.lane}.genome.unaligned" }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.fastqc ?: 'fastqc') as String) + '/genome_unaligned').canonicalPath }, mode: 'copy' ]
    }
    withName: TX_ALIGNED_FASTQC {
        ext.prefix = { "${meta.id}.${meta.lane}.transcriptome.aligned" }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.fastqc ?: 'fastqc') as String) + '/transcriptome_aligned').canonicalPath }, mode: 'copy' ]
    }
    withName: TX_UNALIGNED_FASTQC {
        ext.prefix = { "${meta.id}.${meta.lane}.transcriptome.unaligned" }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.fastqc ?: 'fastqc') as String) + '/transcriptome_unaligned').canonicalPath }, mode: 'copy' ]
    }

    withName: STAR_INDEX {
        storeDir = {
            def d = params.star?.getOrDefault('index_dir', null)
            d ? new File(d).canonicalPath : new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'star_index').canonicalPath
        }
        ext.sjdb_overhang = { params.star?.getOrDefault('sjdb_overhang', 100) }
    }

    // ── Ribo-seq genome route ──────────────────────────────────────────────
    withName: STAR_ALIGN {
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'genome/alignment/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
    }
    withName: '.*:GENOME_ALIGN:SAMTOOLS_QPASS' {
        ext.route  = 'genome'
        ext.prefix = { "${meta.id}.${meta.lane}.genome_alignment" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'genome/quality_filter').canonicalPath }
    }
    withName: '.*:GENOME_ALIGN:BAM_TO_BED' {
        ext.route          = 'genome'
        ext.prefix         = { "${meta.id}.${meta.lane}.genome.qpass" }
        ext.indexed_prefix = { "${meta.id}.${meta.lane}.genome.with_sample_index" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'genome/bam_to_bed/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.alignments ?: 'alignments') as String) + '/ribo/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }, mode: 'link',
                       saveAs: { fn -> (((params.dedup_method ?: 'none').toString().toLowerCase() == 'none' && !((params.deduplicate ?: false).toString().toLowerCase() in ['true', 'yes', 'on', '1'])) && !fn.contains('.with_sample_index.')) ? fn : null } ]
    }
    withName: '.*:GENOME_ALIGN:SAMTOOLS_MERGE' {
        ext.prefix = { "${meta.id}.genome.qpass.merged" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'genome/alignment/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.alignments ?: 'alignments') as String) + '/ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }, mode: 'link',
                       saveAs: { fn -> ((params.dedup_method ?: 'none').toString().toLowerCase() == 'none' && !((params.deduplicate ?: false).toString().toLowerCase() in ['true', 'yes', 'on', '1'])) ? fn : null } ]
    }
    withName: MERGE_PRE_DEDUP_BED {
        ext.prefix = { "${meta.id}.genome.merged.pre_dedup" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'genome/bam_to_bed/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:GENOME_ALIGN:RFC_DEDUP' {
        ext.prefix = { "${meta.id}.genome" }
        storeDir   = { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.alignments ?: 'alignments') as String) + '/ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:GENOME_ALIGN:SEPARATE_BED' {
        ext.route       = 'genome'
        ext.suffix      = 'genome'
        ext.emit_counts = true
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'genome/alignment_ribo/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.alignments ?: 'alignments') as String) + '/ribo/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }, mode: 'link', saveAs: { fn -> fn.endsWith('.count') ? null : fn } ]
    }
    withName: '.*:GENOME_ALIGN:RFC_EXTRACT_DEDUP_READS' {
        ext.route       = 'genome'
        ext.prefix      = { "${meta.id}.post_dedup" }
        ext.emit_counts = true
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'genome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.alignments ?: 'alignments') as String) + '/ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }, mode: 'link', saveAs: { fn -> fn.endsWith('.count') ? null : fn } ]
    }
    withName: '.*:GENOME_ALIGN:UMICOLLAPSE_DEDUP' {
        ext.route       = 'genome'
        ext.prefix      = { "${meta.id}.dedup" }
        ext.emit_counts = true
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'genome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.alignments ?: 'alignments') as String) + '/ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }, mode: 'link', saveAs: { fn -> fn.endsWith('.count') ? null : fn } ]
    }
    withName: '.*:GENOME_ALIGN:SPLIT_DEDUP_BAM' {
        ext.route           = 'genome'
        ext.suffix          = 'post_dedup'
        ext.bed_suffix      = 'genome.post_dedup'
        ext.emit_bed_counts = true
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'genome/alignment_ribo/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.alignments ?: 'alignments') as String) + '/ribo/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }, mode: 'link', saveAs: { fn -> fn.endsWith('.count') ? null : fn } ]
    }
    withName: CONCAT_POST_DEDUP_BED {
        ext.prefix = { "${meta.id}.genome.post_dedup" }
        storeDir   = { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.alignments ?: 'alignments') as String) + '/ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: CONCAT_QPASS_BED_NONE {
        ext.prefix = { "${meta.id}.genome.qpass" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'genome/bam_to_bed/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.alignments ?: 'alignments') as String) + '/ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }, mode: 'link' ]
    }
    withName: DEEPTOOLS_BAMCOVERAGE {
        storeDir = { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.bigwigs ?: 'bigwigs') as String) + '/ribo').canonicalPath }
    }
    withName: SPLIT_STRANDED_BAM {
        storeDir = { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.alignments ?: 'alignments') as String) + '/ribo/stranded').canonicalPath }
    }

    // ── Ribo-seq genome stats ──────────────────────────────────────────────
    withName: '.*:ALIGNMENT_STATS:STATS_INDIVIDUAL' {
        ext.route       = 'genome'
        ext.stats_label = 'genome'
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), ((params.output?.intermediates?.stats ?: 'stats') as String) + '/genome/individual').canonicalPath }
    }
    withName: '.*:ALIGNMENT_STATS:COMBINE_INDIVIDUAL' {
        ext.route  = 'genome'
        ext.prefix = 'genome_individual_essential'
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), ((params.output?.intermediates?.stats ?: 'stats') as String) + '/genome/individual').canonicalPath }
    }
    withName: '.*:ALIGNMENT_STATS:STATS_SUM' {
        ext.route             = 'genome'
        ext.label             = 'genome'
        ext.use_merged_counts = { !((params.dedup_method ?: 'none').toString().toLowerCase() == 'none' && !((params.deduplicate ?: false).toString().toLowerCase() in ['true', 'yes', 'on', '1'])) }
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), ((params.output?.intermediates?.stats ?: 'stats') as String) + '/genome/merged').canonicalPath }
    }
    withName: '.*:ALIGNMENT_STATS:COMBINE_MERGED' {
        ext.route  = 'genome'
        ext.prefix = 'genome_merged_essential'
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), ((params.output?.intermediates?.stats ?: 'stats') as String) + '/genome/merged').canonicalPath }
    }
    withName: '.*:ALIGNMENT_STATS:STATS_PUBLISH' {
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.stats ?: 'stats') as String) + '/genome').canonicalPath }, mode: 'copy' ]
    }
    withName: WRITE_CORRESPONDENCE {
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.stats ?: 'stats') as String)).canonicalPath }, mode: 'copy' ]
    }

    // ── Ribo-seq transcriptome stats (bowtie2 route) ───────────────────────
    withName: '.*:TRANSCRIPTOME_STATS:TX_STATS_INDIVIDUAL' {
        ext.stats_label = 'transcriptome'
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), ((params.output?.intermediates?.stats ?: 'stats') as String) + '/transcriptome/individual').canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_STATS:TX_COMBINE_INDIVIDUAL' {
        ext.prefix      = 'transcriptome_individual_essential'
        ext.stats_label = 'transcriptome'
        storeDir        = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), ((params.output?.intermediates?.stats ?: 'stats') as String) + '/transcriptome/individual').canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_STATS:TX_STATS_SUM' {
        ext.label             = 'transcriptome'
        ext.use_merged_counts = false
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), ((params.output?.intermediates?.stats ?: 'stats') as String) + '/transcriptome/merged').canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_STATS:TX_COMBINE_MERGED' {
        ext.prefix      = 'transcriptome_merged_essential'
        ext.stats_label = 'transcriptome'
        storeDir        = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), ((params.output?.intermediates?.stats ?: 'stats') as String) + '/transcriptome/merged').canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_STATS:TX_STATS_PUBLISH' {
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.stats ?: 'stats') as String) + '/transcriptome').canonicalPath }, mode: 'copy' ]
    }

    // ── STAR transcriptome projection dedup (star.output_transcriptome_bam) ─
    // Has its own `star_transcriptome` tree and `.star_transcriptome.` filenames,
    // so this route and the bowtie2 transcriptome route keep separate storeDirs
    // when both run.
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SAMTOOLS_QPASS' {
        ext.route                  = 'star_transcriptome'
        ext.prefix                 = { "${meta.id}.${meta.lane}.star_transcriptome_alignment" }
        ext.presort                = true
        ext.emit_primary_secondary = false
        ext.count_unique           = false
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'star_transcriptome/quality_filter/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
    }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:BAM_TO_BED' {
        ext.prefix       = { "${meta.id}.${meta.lane}.star_transcriptome.with_sample_index" }
        ext.append_index = true
        storeDir         = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'star_transcriptome/quality_filter/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
    }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:CONCAT_SORT_BED' {
        ext.prefix = { "${meta.id}.star_transcriptome.merged.pre_dedup" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'star_transcriptome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:RFC_DEDUP' {
        ext.prefix = { "${meta.id}.star_transcriptome" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'star_transcriptome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SEPARATE_BED' {
        ext.route  = 'star_transcriptome'
        ext.suffix = 'star_transcriptome'
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'star_transcriptome/alignment_ribo/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
    }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SAMTOOLS_MERGE' {
        ext.prefix = { "${meta.id}.star_transcriptome.qpass.merged" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'star_transcriptome/alignment/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:RFC_EXTRACT_DEDUP_READS' {
        ext.route  = 'star_transcriptome'
        ext.prefix = { "${meta.id}.star_transcriptome.post_dedup" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'star_transcriptome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:UMICOLLAPSE_DEDUP' {
        ext.route  = 'star_transcriptome'
        ext.prefix = { "${meta.id}.star_transcriptome.dedup" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'star_transcriptome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SPLIT_DEDUP_BAM' {
        ext.route      = 'star_transcriptome'
        ext.suffix     = 'star_transcriptome.post_dedup'
        ext.bed_suffix = 'star_transcriptome.post_dedup'
        storeDir       = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'star_transcriptome/alignment_ribo/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
    }

    // ── Ribo-seq transcriptome route (bowtie2 → .ribo) ─────────────────────
    withName: '.*:TRANSCRIPTOME_ALIGN:BOWTIE2_TRANSCRIPTOME' {
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'transcriptome/alignment/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:SAMTOOLS_QPASS' {
        ext.route                  = 'transcriptome'
        ext.prefix                 = { "${meta.id}.${meta.lane}.transcriptome_alignment" }
        ext.presort                = false
        ext.emit_primary_secondary = false
        ext.count_unique           = false
        storeDir                   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'transcriptome/quality_filter').canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:SAMTOOLS_MERGE' {
        ext.prefix = { "${meta.id}.transcriptome.qpass.merged" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'transcriptome/alignment/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:TX_QPASS_BAM_TO_BED' {
        ext.prefix       = { "${meta.id}.${meta.lane}.transcriptome.with_sample_index" }
        ext.append_index = true
        storeDir         = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'transcriptome/quality_filter').canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:TX_MERGED_QPASS_BED' {
        ext.prefix = { "${meta.id}.transcriptome.qpass.merged" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'transcriptome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:TX_MERGED_DEDUP_BED' {
        ext.prefix = { "${meta.id}.transcriptome.dedup" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'transcriptome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:MERGE_TX_PRE_DEDUP_BED' {
        ext.prefix = { "${meta.id}.transcriptome.merged.pre_dedup" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'transcriptome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:RFC_DEDUP' {
        ext.prefix = { "${meta.id}.transcriptome" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'transcriptome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:SEPARATE_BED' {
        ext.route            = 'transcriptome'
        ext.suffix           = 'transcriptome'
        ext.emit_counts      = true
        ext.emit_full_counts = false
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'transcriptome/alignment_ribo/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:RFC_EXTRACT_DEDUP_READS' {
        ext.route       = 'transcriptome'
        ext.prefix      = { "${meta.id}.transcriptome.post_dedup" }
        ext.emit_counts = false
        storeDir        = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'transcriptome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:UMICOLLAPSE_DEDUP' {
        ext.route       = 'transcriptome'
        ext.prefix      = { "${meta.id}.transcriptome.dedup" }
        ext.emit_counts = false
        storeDir        = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'transcriptome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:TRANSCRIPTOME_ALIGN:SPLIT_DEDUP_BAM' {
        ext.route            = 'transcriptome'
        ext.suffix           = 'transcriptome.post_dedup'
        ext.bed_suffix       = 'transcriptome.post_dedup'
        ext.emit_bed_counts  = true
        ext.emit_full_counts = false
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'transcriptome/alignment_ribo/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
    }
    withName: 'RIBOPY_CREATE' {
        storeDir = { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.ribo ?: 'ribo') as String)).canonicalPath }
    }

    // ── RNA-seq preprocess ─────────────────────────────────────────────────
    withName: RNASEQ_RAW_FASTQC {
        ext.prefix = { "${meta.id}.${meta.lane}" }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), 'rnaseq/' + ((params.output?.output?.fastqc ?: 'fastqc') as String) + '/raw').canonicalPath }, mode: 'copy' ]
    }
    withName: RNASEQ_CLIPPED_FASTQC {
        ext.prefix = { "${meta.id}.${meta.lane}.clipped" }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), 'rnaseq/' + ((params.output?.output?.fastqc ?: 'fastqc') as String) + '/clipped').canonicalPath }, mode: 'copy' ]
    }
    withName: CUTADAPT_CLIP_RNASEQ {
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/clip').canonicalPath }
    }
    withName: '.*:RNASEQ_PREPROCESS:UMITOOLS_EXTRACT' {
        ext.args = { params.rnaseq?.umi_tools_extract_arguments ?: '' }
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/umi_tools/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: BOWTIE2_FILTER_RNASEQ {
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/filter').canonicalPath }
    }

    // ── RNA-seq genome route ───────────────────────────────────────────────
    withName: STAR_ALIGN_RNASEQ {
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/genome/alignment/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
        publishDir = [ path: { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/stats/genome/individual').canonicalPath },
                       mode: 'copy', saveAs: { fn -> fn.endsWith('.log') ? fn : null } ]
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:SAMTOOLS_QPASS' {
        ext.route  = 'rnaseq_genome'
        ext.prefix = { "${meta.id}.${meta.lane}.rnaseq.genome_alignment" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/genome/quality_filter').canonicalPath }
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:BAM_TO_BED' {
        ext.prefix         = { "${meta.id}.${meta.lane}.rnaseq.genome.qpass" }
        ext.indexed_prefix = { "${meta.id}.${meta.lane}.rnaseq.genome.with_sample_index" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/genome/bam_to_bed/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), 'rnaseq/' + ((params.output?.output?.alignments ?: 'alignments') as String) + '/genome/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }, mode: 'link',
                       saveAs: { fn -> (((params.rnaseq?.dedup_method ?: 'none').toString().toLowerCase() == 'none') && !fn.contains('.with_sample_index.')) ? fn : null } ]
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:SAMTOOLS_MERGE' {
        ext.prefix = { "${meta.id}.rnaseq.genome.qpass.merged" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/genome/alignment/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), 'rnaseq/' + ((params.output?.output?.alignments ?: 'alignments') as String) + '/genome/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }, mode: 'link',
                       saveAs: { fn -> ((params.rnaseq?.dedup_method ?: 'none').toString().toLowerCase() == 'none') ? fn : null } ]
    }
    withName: 'RNASEQ_MERGE_PRE_DEDUP_BED' {
        ext.prefix = { "${meta.id}.rnaseq.genome.merged.pre_dedup" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/genome/bam_to_bed/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:RFC_DEDUP' {
        ext.prefix = { "${meta.id}.rnaseq.genome" }
        storeDir   = { new File(((params.output?.output?.base ?: 'output') as String), 'rnaseq/' + ((params.output?.output?.alignments ?: 'alignments') as String) + '/genome/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:SEPARATE_BED' {
        ext.route       = 'rnaseq_genome'
        ext.suffix      = 'rnaseq.genome'
        ext.emit_counts = true
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/genome/alignment_ribo/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), 'rnaseq/' + ((params.output?.output?.alignments ?: 'alignments') as String) + '/genome/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }, mode: 'link', saveAs: { fn -> fn.endsWith('.count') ? null : fn } ]
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:RFC_EXTRACT_DEDUP_READS' {
        ext.route       = 'rnaseq_genome'
        ext.prefix      = { "${meta.id}.rnaseq.post_dedup" }
        ext.emit_counts = true
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/genome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), 'rnaseq/' + ((params.output?.output?.alignments ?: 'alignments') as String) + '/genome/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }, mode: 'link', saveAs: { fn -> fn.endsWith('.count') ? null : fn } ]
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:UMICOLLAPSE_DEDUP' {
        ext.route       = 'rnaseq_genome'
        ext.prefix      = { "${meta.id}.rnaseq.dedup" }
        ext.emit_counts = true
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/genome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), 'rnaseq/' + ((params.output?.output?.alignments ?: 'alignments') as String) + '/genome/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }, mode: 'link', saveAs: { fn -> fn.endsWith('.count') ? null : fn } ]
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:SPLIT_DEDUP_BAM' {
        ext.route           = 'rnaseq_genome'
        ext.suffix          = 'rnaseq.post_dedup'
        ext.bed_suffix      = 'rnaseq.genome.post_dedup'
        ext.emit_bed_counts = true
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/genome/alignment_ribo/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), 'rnaseq/' + ((params.output?.output?.alignments ?: 'alignments') as String) + '/genome/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }, mode: 'link', saveAs: { fn -> fn.endsWith('.count') ? null : fn } ]
    }
    withName: 'RNASEQ_CONCAT_QPASS_BED_NONE' {
        ext.prefix = { "${meta.id}.rnaseq.genome.qpass" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/genome/bam_to_bed/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), 'rnaseq/' + ((params.output?.output?.alignments ?: 'alignments') as String) + '/genome/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }, mode: 'link' ]
    }
    withName: 'RNASEQ_CONCAT_POST_DEDUP_BED' {
        ext.prefix = { "${meta.id}.rnaseq.genome.post_dedup" }
        storeDir   = { new File(((params.output?.output?.base ?: 'output') as String), 'rnaseq/' + ((params.output?.output?.alignments ?: 'alignments') as String) + '/genome/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:RNASEQ_GENOME_ALIGN:DEEPTOOLS_BAMCOVERAGE' {
        storeDir = { new File(((params.output?.output?.base ?: 'output') as String), 'rnaseq/' + ((params.output?.output?.bigwigs ?: 'bigwigs') as String) + '/genome').canonicalPath }
    }

    // ── RNA-seq transcriptome route ────────────────────────────────────────
    withName: BOWTIE2_TRANSCRIPTOME_RNASEQ {
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/transcriptome/alignment/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:SAMTOOLS_QPASS' {
        ext.route                  = 'rnaseq_transcriptome'
        ext.prefix                 = { "${meta.id}.${meta.lane}.rnaseq.transcriptome_alignment" }
        ext.presort                = false
        ext.emit_primary_secondary = false
        ext.count_unique           = false
        storeDir                   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/transcriptome/quality_filter').canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:SAMTOOLS_MERGE' {
        ext.prefix = { "${meta.id}.rnaseq.transcriptome.qpass.merged" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/transcriptome/alignment/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:RNASEQ_TX_QPASS_BAM_TO_BED' {
        ext.prefix       = { "${meta.id}.${meta.lane}.rnaseq.transcriptome.with_sample_index" }
        ext.append_index = true
        storeDir         = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/transcriptome/quality_filter').canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:RNASEQ_TX_MERGED_QPASS_BED' {
        ext.prefix = { "${meta.id}.rnaseq.transcriptome.qpass.merged" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/transcriptome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:RNASEQ_TX_MERGED_DEDUP_BED' {
        ext.prefix = { "${meta.id}.rnaseq.transcriptome.dedup" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/transcriptome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: 'RNASEQ_MERGE_TX_PRE_DEDUP_BED' {
        ext.prefix = { "${meta.id}.rnaseq.transcriptome.merged.pre_dedup" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/transcriptome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:RFC_DEDUP' {
        ext.prefix = { "${meta.id}.rnaseq.transcriptome" }
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/transcriptome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:SEPARATE_BED' {
        ext.route            = 'rnaseq_transcriptome'
        ext.suffix           = 'rnaseq.transcriptome'
        ext.emit_counts      = true
        ext.emit_full_counts = false
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/transcriptome/alignment_ribo/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:RFC_EXTRACT_DEDUP_READS' {
        ext.route       = 'rnaseq_transcriptome'
        ext.prefix      = { "${meta.id}.rnaseq.transcriptome.post_dedup" }
        ext.emit_counts = false
        storeDir        = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/transcriptome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:UMICOLLAPSE_DEDUP' {
        ext.route       = 'rnaseq_transcriptome'
        ext.prefix      = { "${meta.id}.rnaseq.transcriptome.dedup" }
        ext.emit_counts = false
        storeDir        = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/transcriptome/alignment_ribo/' + ((params.output?.merged_lane_directory ?: 'merged') as String)).canonicalPath }
    }
    withName: '.*:RNASEQ_TRANSCRIPTOME_ALIGN:SPLIT_DEDUP_BAM' {
        ext.route            = 'rnaseq_transcriptome'
        ext.suffix           = 'rnaseq.transcriptome.post_dedup'
        ext.bed_suffix       = 'rnaseq.transcriptome.post_dedup'
        ext.emit_bed_counts  = true
        ext.emit_full_counts = false
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/transcriptome/alignment_ribo/' + ((params.output?.individual_lane_directory ?: 'individual') as String)).canonicalPath }
    }

    withName: RIBOPY_RNASEQ_SET {
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'transcriptome/ribo_rnaseq').canonicalPath }
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.ribo ?: 'ribo') as String)).canonicalPath }, mode: 'link',
                       saveAs: { fn -> fn.replaceAll('\\.rnaseq', '') } ]
    }
    withName: RIBOPY_MERGE {
        storeDir = { new File(((params.output?.output?.base ?: 'output') as String), ((params.output?.output?.ribo ?: 'ribo') as String)).canonicalPath }
    }

    // ── RNA-seq genome stats (ALIGNMENT_STATS aliased as RNASEQ_GENOME_STATS) ─
    withName: '.*:RNASEQ_GENOME_STATS:STATS_INDIVIDUAL' {
        ext.route       = 'rnaseq_genome'
        ext.stats_label = 'rnaseq_genome'
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/stats/genome/individual').canonicalPath }
    }
    withName: '.*:RNASEQ_GENOME_STATS:COMBINE_INDIVIDUAL' {
        ext.route  = 'rnaseq_genome'
        ext.prefix = 'rnaseq_genome_individual_essential'
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/stats/genome/individual').canonicalPath }
    }
    withName: '.*:RNASEQ_GENOME_STATS:STATS_SUM' {
        ext.route             = 'rnaseq_genome'
        ext.label             = 'rnaseq_genome'
        ext.use_merged_counts = { !((params.rnaseq?.dedup_method ?: 'none').toString().toLowerCase() == 'none') }
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/stats/genome/merged').canonicalPath }
    }
    withName: '.*:RNASEQ_GENOME_STATS:COMBINE_MERGED' {
        ext.route  = 'rnaseq_genome'
        ext.prefix = 'rnaseq_genome_merged_essential'
        storeDir   = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/stats/genome/merged').canonicalPath }
    }
    withName: '.*:RNASEQ_GENOME_STATS:STATS_PUBLISH' {
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), 'rnaseq/' + ((params.output?.output?.stats ?: 'stats') as String) + '/genome').canonicalPath }, mode: 'copy' ]
    }

    // ── RNA-seq transcriptome stats (TRANSCRIPTOME_STATS aliased as RNASEQ_TX_STATS)
    withName: '.*:RNASEQ_TX_STATS:TX_STATS_INDIVIDUAL' {
        ext.stats_label = 'rnaseq_transcriptome'
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/stats/transcriptome/individual').canonicalPath }
    }
    withName: '.*:RNASEQ_TX_STATS:TX_COMBINE_INDIVIDUAL' {
        ext.prefix      = 'rnaseq_transcriptome_individual_essential'
        ext.stats_label = 'transcriptome'
        storeDir        = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/stats/transcriptome/individual').canonicalPath }
    }
    withName: '.*:RNASEQ_TX_STATS:TX_STATS_SUM' {
        ext.label             = 'rnaseq_transcriptome'
        ext.use_merged_counts = false
        storeDir = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/stats/transcriptome/merged').canonicalPath }
    }
    withName: '.*:RNASEQ_TX_STATS:TX_COMBINE_MERGED' {
        ext.prefix      = 'rnaseq_transcriptome_merged_essential'
        ext.stats_label = 'transcriptome'
        storeDir        = { new File(((params.output?.intermediates?.base ?: 'intermediates') as String), 'rnaseq/stats/transcriptome/merged').canonicalPath }
    }
    withName: '.*:RNASEQ_TX_STATS:TX_STATS_PUBLISH' {
        publishDir = [ path: { new File(((params.output?.output?.base ?: 'output') as String), 'rnaseq/' + ((params.output?.output?.stats ?: 'stats') as String) + '/transcriptome').canonicalPath }, mode: 'copy' ]
    }
}
