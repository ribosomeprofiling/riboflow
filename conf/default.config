executor {
    cpus   = 16
    memory = '64.GB'
}

process {
    executor = 'local'

    resourceLimits = [ cpus: 16, memory: 64.GB ]

    withName: 'SAMTOOLS_QPASS|SAMTOOLS_MERGE|SPLIT_STRANDED_BAM|SPLIT_DEDUP_BAM|RFC_EXTRACT_DEDUP_READS|.*FASTQC' {
        cpus   = 4
        memory = '8.GB'
    }

    withName: 'CUTADAPT_CLIP|CUTADAPT_CLIP_RNASEQ' {
        cpus   = 4
        memory = '2.GB'
    }

    withName: 'UMITOOLS_EXTRACT' {
        cpus   = 1
        memory = '2.GB'
    }

    withName: 'BOWTIE2_FILTER|BOWTIE2_FILTER_RNASEQ|BOWTIE2_TRANSCRIPTOME|BOWTIE2_TRANSCRIPTOME_RNASEQ' {
        cpus   = 8
        memory = '8.GB'
    }

    // Memory scales with the attempt and exit 102 (STAR: not enough memory for BAM
    // sorting) retries — a constant allocation made every retry fail identically.
    withName: 'STAR_ALIGN' {
        cpus          = 8
        memory        = { 48.GB * task.attempt }
        maxForks      = 1
        errorStrategy = { task.exitStatus in [102,104,134,137,139,140,143,247] ? 'retry' : 'terminate' }
    }

    withName: 'STAR_ALIGN_RNASEQ' {
        cpus          = 8
        memory        = { 48.GB * task.attempt }
        maxForks      = 1
        errorStrategy = { task.exitStatus in [102,104,134,137,139,140,143,247] ? 'retry' : 'terminate' }
    }

    withName: '.*STAR_INDEX' {
        cpus     = 8
        memory   = '48.GB'
        maxForks = 1
    }

    withName: 'UMICOLLAPSE_DEDUP' {
        cpus         = 4
        memory       = { 8.GB * task.attempt }
        ext.algo     = 'cc'
        // JVM heap must grow with the container or a retry OOMs identically.
        ext.jvm_opts = { "-Xms512m -Xmx${6 * task.attempt}g -Xss256m" }
    }

    withName: 'RIBOPY_CREATE' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
    }

    // Neither tool is multi-threaded; reserving 4 cpus only blocked the slot.
    withName: 'RIBOPY_MERGE|RIBOPY_RNASEQ_SET' {
        cpus   = 1
        memory = '4.GB'
    }

    // Whole-sample BED sort / split / dedup steps. They used to fall through to the
    // 1 cpu / 2 GB default, so `sort` on a full-sample BED spilled heavily.
    withName: '.*BED.*|.*RFC_DEDUP' {
        cpus   = 4
        memory = '16.GB'
    }

    withName: '.*DEEPTOOLS_BAMCOVERAGE' {
        cpus   = 4
        memory = '8.GB'
    }

    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SAMTOOLS_QPASS'          { cpus = 4; memory = '8.GB' }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SAMTOOLS_MERGE'          { cpus = 4; memory = '8.GB' }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SPLIT_DEDUP_BAM'         { cpus = 4; memory = '8.GB' }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:RFC_EXTRACT_DEDUP_READS' { cpus = 4; memory = '8.GB' }
}
